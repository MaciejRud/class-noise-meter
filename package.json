{
  "name": "cicho-metr",
  "version": "0.1.0",
  "description": "Floating classroom noise meter with a loud-time counter",
  "main": "main.js",
  "private": true,
  "author": "MaciejRud",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac --universal"
  },
  "build": {
    "appId": "pl.cichometr.app",
    "productName": "Cicho-metr",
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Cicho-metr mierzy poziom hałasu w klasie."
      }
    }
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3"
  }
}
